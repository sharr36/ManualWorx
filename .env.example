# =============================================================================
# ManualWorx Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# --- AI (Only External Dependency) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Database (Fly Postgres) ---
DATABASE_URL=postgresql://manualworx:password@localhost:5432/manualworx

# --- Redis (Upstash via Fly) ---
REDIS_URL=redis://localhost:6379

# --- Vector Database (Qdrant on Fly) ---
QDRANT_URL=http://localhost:6333

# --- Object Storage (Tigris / S3-compatible) ---
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=manualworx

# --- Stripe Billing ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_SHOP_BASE_MONTHLY=price_...
STRIPE_PRICE_SHOP_PER_USER_MONTHLY=price_...

# --- OCR (Optional — falls back to PyMuPDF if not set) ---
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Embeddings (Optional — falls back to Together.ai) ---
EMBEDDING_PROVIDER=together  # together | self_hosted
EMBEDDING_SERVICE_URL=http://gpu-service.internal:8080
TOGETHER_API_KEY=

# --- Claude Models ---
DEFAULT_MODEL=claude-sonnet-4-5-20250929
ESCALATION_MODEL=claude-opus-4-5-20250120

# --- App Config ---
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
CORS_ORIGINS=http://localhost:3000
MAX_PAGES_PER_QUERY=10
STREAM_RESPONSES=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Schematic Viewer ---
SYMBOL_LIBRARY_PATH=/app/assets/symbols/
ANNOTATION_CACHE_TTL=86400
